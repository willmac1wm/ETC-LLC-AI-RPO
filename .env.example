# Copy this to .env and fill in values before deploying

# API key — clients must send: Authorization: Bearer <API_KEY>
# Leave blank to disable auth (development only)
API_KEY=change-me-before-deploying

# Flask secret key (any random string)
SECRET_KEY=change-me-too

# Comma-separated list of allowed CORS origins
# Set to your Vercel/Netlify URL, e.g:
#   ALLOWED_ORIGINS=https://your-game.vercel.app,https://your-game.netlify.app
ALLOWED_ORIGINS=*

# Port the API server listens on (Railway/Render set this automatically)
PORT=8766

# HuggingFace model to use if fine-tuned model is not present
# Options: openai/whisper-base.en  openai/whisper-small.en  openai/whisper-medium.en
CLOUD_MODEL=openai/whisper-base.en
